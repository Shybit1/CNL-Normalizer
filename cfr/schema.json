{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command Formal Representation (CFR) v1.0",
  "description": "Canonical output of Layer 1 (Semantic Interface). Contains the operator's command in deterministic, validated, machine-readable form.",
  "type": "object",
  "required": [
    "schema_version",
    "grammar_version",
    "constraint_version",
    "timestamp",
    "intent",
    "parameters",
    "constraints",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version of CFR structure (e.g., '1.0')"
    },
    "grammar_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version of grammar used for parsing"
    },
    "constraint_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version of constraint vocabulary"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the command was processed (UTC)"
    },
    "intent": {
      "type": "string",
      "enum": [
        "ALTITUDE_CHANGE",
        "WAYPOINT_NAVIGATION",
        "FORMATION_CHANGE",
        "HOLD_LOITER",
        "ABORT_RTL"
      ],
      "description": "Intent type recognized by grammar parser"
    },
    "parameters": {
      "type": "object",
      "description": "Mission parameters specific to the intent type",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "description": "Operational restrictions imposed by the operator",
      "properties": {
        "max_g_force": {
          "oneOf": [
            {"type": "number", "minimum": 0, "exclusiveMinimum": true},
            {"type": "array", "items": {"type": "number", "minimum": 0, "exclusiveMinimum": true}}
          ]
        },
        "no_fly_zones": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of zones/entities to avoid"
        },
        "time": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "max_speed": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "min_speed": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "max_altitude": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "min_altitude": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        }
      },
      "additionalProperties": true
    },
    "mission_phase": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "description": "Explicit mission phase if provided by operator; null otherwise (PRD §34)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Deterministic confidence score (1.0 = maximum)"
    },
    "metadata": {
      "type": "object",
      "description": "Optional extended metadata",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
